# --- SELF-VALIDATION (cycle 1171 lesson: prove the gate can fire) ---
for _s, _t in DIFF.items():
    assert _s != _t, f"table violates the differing-pairs invariant: {_s}=={_t}"
    assert len(_s) == 1 and len(_t) == 1, f"non-char entry: {_s!r}->{_t!r}"
CANARY = {"们": "們", "这": "這", "国": "國", "龙": "龍", "电": "電", "风": "風",
          "车": "車", "长": "長", "书": "書", "说": "說", "门": "門", "东": "東"}
for _s, _t in CANARY.items():
    assert DIFF.get(_s) == _t, f"CANARY FAILED: {_s} -> {DIFF.get(_s)} (want {_t})"
assert len(DIFF) > 700, f"table suspiciously small: {len(DIFF)}"
print(f"[gate] table OK: {len(DIFF)} differing S->T pairs; {len(CANARY)} canaries verified")
